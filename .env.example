# App
PUBLIC_ASSETS_BASE=https://your-cdn-url.com
ORIGIN=https://your-domain.com # production only; overridden locally via docker-compose.override.yml
WS_RELAY_URL=http://ws-relay:8000 # Docker internal; use http://localhost:8000 for local dev

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY=your-access-key-id
R2_SECRET_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name

# Discord
PUBLIC_DISCORD_CLIENT_ID=your-discord-client-id